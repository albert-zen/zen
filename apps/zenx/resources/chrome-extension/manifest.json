{
  "manifest_version": 3,
  "name": "ZenX Current Tab Bridge",
  "version": "1.0.0",
  "description": "Connect one tab you explicitly choose to the local ZenX browser tools.",
  "key": "",
  "permissions": ["activeTab", "debugger", "nativeMessaging"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Connect this tab to ZenX"
  }
}
