{
  "manifest_version": 3,
  "name": "ZenX Browser Bridge",
  "version": "3.3.0",
  "minimum_chrome_version": "120",
  "description": "Use existing pages or automatically grouped task tabs with ZenX. Reconnects when ZenX restarts.",
  "icons": {
    "16": "icons/zenx-16.png",
    "32": "icons/zenx-32.png",
    "48": "icons/zenx-48.png",
    "128": "icons/zenx-128.png"
  },
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/zenx-16.png",
      "24": "icons/zenx-24.png",
      "32": "icons/zenx-32.png"
    },
    "default_title": "Connect this browser to ZenX"
  }
}
