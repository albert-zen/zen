{
  "manifest_version": 3,
  "name": "ZenX Browser Bridge",
  "version": "2.0.0",
  "description": "Connect Chrome to ZenX once to work together across existing and new web tabs.",
  "icons": {
    "16": "icons/zenx-16.png",
    "32": "icons/zenx-32.png",
    "48": "icons/zenx-48.png",
    "128": "icons/zenx-128.png"
  },
  "key": "",
  "permissions": ["tabs", "debugger", "nativeMessaging"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/zenx-16.png",
      "24": "icons/zenx-24.png",
      "32": "icons/zenx-32.png"
    },
    "default_title": "Connect Chrome to ZenX"
  }
}
