{
  "schemaVersion": 2,
  "id": "zenx-rooms",
  "name": "Rooms",
  "version": "1.0.4",
  "description": "Manage shared ZenX Room collaboration.",
  "compatibility": {
    "zenx": ">=0.1.0 <0.2.0"
  },
  "runtime": {
    "type": "bundled",
    "entry": "./dist/runtime.js"
  },
  "mainDocument": "Use Rooms for shared communication. Companion workspace/read/update tools maintain bounded editable planning annotations with revision CAS; inspect real Thread/Trigger status separately. No mutable notes are injected into context without explicit reads.",
  "storageVersion": 1,
  "provider": {
    "id": "zenx-automation-service",
    "platforms": ["*"],
    "interactionModes": ["background_safe"],
    "capabilities": ["zenx.rooms.manage"]
  },
  "permissions": [
    {
      "id": "zenx-rooms.read",
      "title": "Read Rooms",
      "description": "List Rooms and bounded recent messages.",
      "scope": "workspace"
    },
    {
      "id": "zenx-rooms.write",
      "title": "Manage Rooms",
      "description": "Create, update, cancel, and delete Triggers and manage Room collaboration.",
      "scope": "local-device"
    }
  ],
  "tools": [
    {
      "name": "zenx_rooms_list",
      "description": "Page Rooms and bounded preview metadata; use zenx_rooms_messages for full transcript.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.read"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_create",
      "description": "Create a Room with named Thread members.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 128
                },
                "threadId": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "required": ["name", "threadId"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "members"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_rename",
      "description": "Rename an existing Room.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "name": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": ["roomId", "name"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_delete",
      "description": "Delete a Room when no nonterminal wakeup owns its reply route.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": ["roomId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_add_member",
      "description": "Add a named Thread member to a Room.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "threadId": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": ["roomId", "name", "threadId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_remove_member",
      "description": "Remove a Thread member from a Room.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "threadId": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": ["roomId", "threadId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_post_message",
      "description": "Post an Agent-attributed Room message; explicit mentions may wake registered members.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "text": {
            "type": "string",
            "maxLength": 8000
          },
          "operationId": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": ["roomId", "text"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_prepare_message",
      "description": "Prepare trusted human Room operation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "operationId": {
            "type": "string",
            "maxLength": 512
          },
          "text": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "required": ["roomId", "operationId", "text"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_cancel_prepared",
      "description": "Cancel only an exact, not-yet-posted trusted UI Room operation; never withdraw a saved message.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "operationId": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": ["roomId", "operationId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_operation",
      "description": "Read trusted Room operation and wakeup status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "operationId": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": ["roomId", "operationId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.read"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_ack_operation",
      "description": "Acknowledge viewed Room operation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "operationId": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": ["roomId", "operationId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_delivery",
      "description": "Read retained message-associated Room delivery by immutable message ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "messageId": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": ["roomId", "messageId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.read"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_operations",
      "description": "Page retained unacknowledged Room operations for trusted UI.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "cursor": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["roomId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.read"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_messages",
      "description": "Read a bounded chronological page of canonical Room messages.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "cursor": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["roomId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.read"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536,
      "name": "zenx_rooms_create_assistant",
      "description": "Trusted UI only: create a single-member Always On Assistant preset Room and its input Trigger. Setup does not start a Turn; future human messages can start model execution.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 128
                },
                "threadId": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "required": ["name", "threadId"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "members"],
        "additionalProperties": false
      }
    },
    {
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536,
      "name": "zenx_rooms_assistant_replies",
      "description": "Trusted UI only: pause or enable future assistant replies. Does not interrupt already admitted work.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": ["roomId", "enabled"],
        "additionalProperties": false
      }
    },
    {
      "name": "zenx_rooms_workspace",
      "description": "Explicitly read a Companion Room planning notebook. Editable matters, memory and exact references are annotations, not live execution status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": ["roomId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.read"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_rooms_update_workspace",
      "description": "Replace Companion planning annotations only if expectedRevision matches. Host validates bounded UTF-8, uniqueness, exact references and total 40 KiB. Re-read and deliberately merge after conflict. Does not execute resources or create Triggers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "matters": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "plan": {
                  "type": "string",
                  "maxLength": 2000
                },
                "statusNote": {
                  "type": "string",
                  "maxLength": 512
                },
                "notes": {
                  "type": "string",
                  "maxLength": 4000
                },
                "references": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": ["thread"]
                          },
                          "device": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512
                          },
                          "workspace": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "threadId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512
                          },
                          "label": {
                            "type": "string",
                            "maxLength": 256
                          }
                        },
                        "required": [
                          "kind",
                          "device",
                          "workspace",
                          "threadId",
                          "label"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": ["trigger"]
                          },
                          "triggerId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512
                          },
                          "label": {
                            "type": "string",
                            "maxLength": 256
                          }
                        },
                        "required": ["kind", "triggerId", "label"],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "id",
                "title",
                "plan",
                "statusNote",
                "notes",
                "references"
              ],
              "additionalProperties": false
            }
          },
          "memory": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "text": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "required": ["id", "title", "text"],
              "additionalProperties": false
            }
          }
        },
        "required": ["roomId", "expectedRevision", "matters", "memory"],
        "additionalProperties": false
      },
      "permissions": ["zenx-rooms.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.rooms.manage"],
      "maxOutputBytes": 65536
    }
  ],
  "ui": {
    "bundles": [
      {
        "id": "main",
        "apiVersion": 1,
        "kind": "trusted",
        "entry": "zenx/bundled/rooms-ui"
      }
    ],
    "surfaces": [
      {
        "id": "rooms-page",
        "bundleId": "main",
        "exportName": "rooms-page"
      }
    ]
  },
  "contributions": {
    "pages": [
      {
        "id": "rooms",
        "title": "Rooms",
        "route": "/plugins/zenx-rooms/rooms",
        "surfaceId": "rooms-page"
      }
    ],
    "sidebar": [
      {
        "id": "rooms",
        "label": "Rooms",
        "icon": "users",
        "pageId": "rooms",
        "order": 20
      }
    ],
    "commands": [
      {
        "id": "list",
        "title": "List Rooms, members, and bounded recent messages.",
        "tool": "zenx_rooms_list"
      },
      {
        "id": "create",
        "title": "Create a Room with named Thread members.",
        "tool": "zenx_rooms_create"
      },
      {
        "id": "rename",
        "title": "Rename an existing Room.",
        "tool": "zenx_rooms_rename"
      },
      {
        "id": "delete",
        "title": "Delete a Room when no nonterminal wakeup owns its reply route.",
        "tool": "zenx_rooms_delete"
      },
      {
        "id": "add-member",
        "title": "Add a named Thread member to a Room.",
        "tool": "zenx_rooms_add_member"
      },
      {
        "id": "remove-member",
        "title": "Remove a Thread member from a Room.",
        "tool": "zenx_rooms_remove_member"
      },
      {
        "id": "post-message",
        "title": "Post an Agent-attributed Room message; explicit mentions may wake registered members.",
        "tool": "zenx_rooms_post_message"
      },
      {
        "id": "prepare-message",
        "title": "Prepare trusted human Room operation.",
        "tool": "zenx_rooms_prepare_message"
      },
      {
        "id": "cancel-prepared",
        "title": "Explicitly cancel a not-yet-posted Room operation.",
        "tool": "zenx_rooms_cancel_prepared"
      },
      {
        "id": "operation",
        "title": "Read trusted Room operation.",
        "tool": "zenx_rooms_operation"
      },
      {
        "id": "ack-operation",
        "title": "Acknowledge viewed Room operation.",
        "tool": "zenx_rooms_ack_operation"
      },
      {
        "id": "delivery",
        "title": "Read message delivery by Room message ID.",
        "tool": "zenx_rooms_delivery"
      },
      {
        "id": "operations",
        "title": "Page unresolved Room operations.",
        "tool": "zenx_rooms_operations"
      },
      {
        "id": "messages",
        "title": "Read bounded Room messages page.",
        "tool": "zenx_rooms_messages"
      },
      {
        "id": "create-assistant",
        "title": "Create an Always On Assistant conversation",
        "tool": "zenx_rooms_create_assistant"
      },
      {
        "id": "assistant-replies",
        "title": "Change future assistant replies",
        "tool": "zenx_rooms_assistant_replies"
      },
      {
        "id": "workspace",
        "title": "Read Companion planning notebook",
        "tool": "zenx_rooms_workspace"
      },
      {
        "id": "update-workspace",
        "title": "Save Companion planning notebook with revision check",
        "tool": "zenx_rooms_update_workspace"
      }
    ]
  }
}
