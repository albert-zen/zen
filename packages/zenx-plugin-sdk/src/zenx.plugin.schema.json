{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenx.dev/schemas/zenx.plugin.v2.schema.json",
  "title": "ZenX Plugin Manifest v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "compatibility",
    "mainDocument",
    "provider",
    "permissions",
    "tools",
    "runtime"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "#/$defs/pluginId" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "version": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "compatibility": {
      "type": "object",
      "required": ["zenx"],
      "properties": { "zenx": { "const": ">=0.1.0 <0.2.0" } }
    },
    "mainDocument": { "$ref": "#/$defs/nonEmptyString" },
    "storageVersion": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "provider": {
      "type": "object",
      "required": ["id", "platforms", "interactionModes", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "platforms": { "$ref": "#/$defs/nonEmptyStringArray" },
        "interactionModes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interactionMode" }
        },
        "capabilities": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "scope"],
        "properties": {
          "id": { "$ref": "#/$defs/nonEmptyString" },
          "title": { "$ref": "#/$defs/nonEmptyString" },
          "description": { "$ref": "#/$defs/nonEmptyString" },
          "scope": { "enum": ["browser-session", "local-device", "workspace"] }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "inputSchema",
          "permissions",
          "interactionMode",
          "capabilities"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "description": { "$ref": "#/$defs/nonEmptyString" },
          "inputSchema": { "type": "object" },
          "permissions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "interactionMode": { "$ref": "#/$defs/interactionMode" },
          "capabilities": { "$ref": "#/$defs/nonEmptyStringArray" },
          "maxOutputBytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 1048576
          }
        }
      }
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "entry"],
          "properties": {
            "type": { "const": "bundled" },
            "entry": { "$ref": "#/$defs/packagePath" }
          }
        },
        {
          "type": "object",
          "required": ["type", "entry"],
          "properties": {
            "type": { "const": "process" },
            "entry": { "$ref": "#/$defs/packagePath" },
            "args": { "type": "array", "items": { "type": "string" } },
            "timeoutMs": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "http" },
            "url": { "type": "string", "pattern": "^https?://" },
            "timeoutMs": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "ui": {
      "type": "object",
      "required": ["bundles", "surfaces"],
      "properties": {
        "bundles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "apiVersion", "kind", "entry"],
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "apiVersion": { "$ref": "#/$defs/hostSdkVersion" },
              "kind": { "enum": ["trusted", "isolated"] },
              "entry": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "bundleId", "exportName"],
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "bundleId": { "$ref": "#/$defs/contributionId" },
              "exportName": { "$ref": "#/$defs/contributionId" }
            }
          }
        }
      }
    },
    "contributions": { "type": "object" }
  },
  "$defs": {
    "hostSdkVersion": { "const": 1 },
    "pluginId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "contributionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "interactionMode": {
      "enum": ["background_safe", "foreground_required", "isolated"]
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "description": "A file path resolved within the npm package root; validate also rejects symlink escapes."
    }
  }
}
