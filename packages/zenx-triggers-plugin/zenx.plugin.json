{
  "id": "zenx-triggers",
  "version": "1.0.0",
  "description": "Schedule and inspect ZenX Trigger wakeups.",
  "provider": {
    "id": "zenx-automation-service",
    "platforms": ["*"],
    "interactionModes": ["background_safe"],
    "capabilities": ["zenx.triggers.manage"]
  },
  "permissions": [
    {
      "id": "zenx-triggers.read",
      "title": "Read Triggers",
      "description": "List Trigger definitions, bounded wakeup history, Thread discovery, and referenced source results.",
      "scope": "workspace"
    },
    {
      "id": "zenx-triggers.write",
      "title": "Manage Triggers",
      "description": "Create, update, cancel, and delete Triggers and manage Room collaboration.",
      "scope": "local-device"
    }
  ],
  "tools": [
    {
      "name": "zenx_triggers_threads",
      "description": "Discover readable Thread targets for notification setup.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "permissions": ["zenx-triggers.read"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.triggers.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_triggers_result",
      "description": "Read the exact source Turn preview of a retained notification; full original content is available through Thread reading.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "historyId": {
            "type": "string"
          }
        },
        "required": ["historyId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-triggers.read"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.triggers.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_triggers_list",
      "description": "List Trigger definitions and bounded wakeup history.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "permissions": ["zenx-triggers.read"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.triggers.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_triggers_create",
      "description": "Create a timer, Thread watcher, Room mention, or signal Trigger, optionally with a local predicate/action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string",
            "maxLength": 512,
            "description": "Notification target: full ID, unique short ID, or exact title. On creation defaults to the calling Thread."
          },
          "kind": {
            "type": "string",
            "enum": ["timer", "thread", "roomMention", "signal"]
          },
          "label": {
            "type": "string",
            "maxLength": 256
          },
          "prompt": {
            "type": "string",
            "maxLength": 4096
          },
          "runAt": {
            "type": "number"
          },
          "intervalMinutes": {
            "type": "number"
          },
          "watchedThreadId": {
            "type": "string",
            "maxLength": 512,
            "description": "Source Thread: full ID, unique short ID, or exact title."
          },
          "once": {
            "type": "boolean",
            "description": "Attempt one notification, then stop listening. New thread watches default to true; false listens to every future Turn."
          },
          "includeLatest": {
            "type": "boolean",
            "description": "On creation, notify the latest Turn if it has already ended; otherwise wait for the active or next Turn."
          },
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "mention": {
            "type": "string",
            "maxLength": 128
          },
          "signalName": {
            "type": "string",
            "maxLength": 512
          },
          "program": {
            "type": "object",
            "properties": {
              "predicate": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "maxItems": 64
                  },
                  "cwd": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "env": {
                    "type": "object",
                    "maxProperties": 64,
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "timeoutMs": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 120000
                  },
                  "maxOutputBytes": {
                    "type": "integer",
                    "minimum": 256,
                    "maximum": 1048576
                  }
                },
                "required": ["command"],
                "additionalProperties": false
              },
              "action": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "maxItems": 64
                  },
                  "cwd": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "env": {
                    "type": "object",
                    "maxProperties": 64,
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "timeoutMs": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 120000
                  },
                  "maxOutputBytes": {
                    "type": "integer",
                    "minimum": 256,
                    "maximum": 1048576
                  }
                },
                "required": ["command"],
                "additionalProperties": false
              },
              "match": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "enum": ["completedItemText"]
                  },
                  "regex": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "flags": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "required": ["field", "regex"],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["kind", "label", "prompt"],
        "additionalProperties": false
      },
      "permissions": ["zenx-triggers.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.triggers.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_triggers_update",
      "description": "Replace an existing Trigger definition while preserving its identity and active state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 512
          },
          "threadId": {
            "type": "string",
            "maxLength": 512,
