          },
          "runAt": {
            "type": "number"
          },
          "intervalMinutes": {
            "type": "number"
          },
          "watchedThreadId": {
            "type": "string",
            "maxLength": 512,
            "description": "Source Thread: full ID, unique short ID, or exact title."
          },
          "once": {
            "type": "boolean",
            "description": "Attempt one notification, then stop listening. New thread watches default to true; false listens to every future Turn."
          },
          "includeLatest": {
            "type": "boolean",
            "description": "On creation, notify the latest Turn if it has already ended; otherwise wait for the active or next Turn."
          },
          "roomId": {
            "type": "string",
            "maxLength": 512
          },
          "mention": {
            "type": "string",
            "maxLength": 128
          },
          "signalName": {
            "type": "string",
            "maxLength": 512
          },
          "program": {
            "type": "object",
            "properties": {
              "predicate": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "maxItems": 64
                  },
                  "cwd": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "env": {
                    "type": "object",
                    "maxProperties": 64,
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "timeoutMs": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 120000
                  },
                  "maxOutputBytes": {
                    "type": "integer",
                    "minimum": 256,
                    "maximum": 1048576
                  }
                },
                "required": ["command"],
                "additionalProperties": false
              },
              "action": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "maxItems": 64
                  },
                  "cwd": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "env": {
                    "type": "object",
                    "maxProperties": 64,
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "timeoutMs": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 120000
                  },
                  "maxOutputBytes": {
                    "type": "integer",
                    "minimum": 256,
                    "maximum": 1048576
                  }
                },
                "required": ["command"],
                "additionalProperties": false
              },
              "match": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "enum": ["completedItemText"]
                  },
                  "regex": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "flags": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "required": ["field", "regex"],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["id", "threadId", "kind", "label", "prompt"],
        "additionalProperties": false
      },
      "permissions": ["zenx-triggers.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.triggers.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_triggers_cancel",
      "description": "Deactivate a Trigger without deleting its definition or history.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "triggerId": {
            "type": "string"
          }
        },
        "required": ["triggerId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-triggers.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.triggers.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_triggers_delete",
      "description": "Delete a Trigger definition while preserving audit history.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "triggerId": {
            "type": "string"
          }
        },
        "required": ["triggerId"],
        "additionalProperties": false
      },
      "permissions": ["zenx-triggers.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.triggers.manage"],
      "maxOutputBytes": 65536
    },
    {
      "name": "zenx_triggers_signal",
      "description": "Emit an explicit named signal; matching Triggers may start ordinary Agent Turns.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 512
          },
          "detail": {
            "type": "string"
          }
        },
        "required": ["name", "detail"],
        "additionalProperties": false
      },
      "permissions": ["zenx-triggers.write"],
      "interactionMode": "background_safe",
      "capabilities": ["zenx.triggers.manage"],
      "maxOutputBytes": 65536
    }
  ],
  "schemaVersion": 2,
  "name": "Triggers",
  "compatibility": {
    "zenx": ">=0.1.0 <0.2.0"
  },
  "runtime": {
    "type": "bundled",
    "entry": "./dist/runtime.js"
  },
  "mainDocument": "Use Triggers to notify a Thread when another Turn ends. Full IDs, unique short IDs and exact titles select Threads. New thread watches default to one notification attempt; omit threadId to notify the calling Thread. includeLatest checks an already ended latest Turn. Use list for delivery state, result for the exact source Turn preview, and cancel to stop listening. queued means accepted input, not completed work. Failed/interrupted source Turns are explicitly labeled. Offline events are not replayed; failed or unknown sends are not retried.",
  "ui": {
    "bundles": [
      {
        "id": "main",
        "apiVersion": 1,
        "kind": "trusted",
        "entry": "zenx/bundled/triggers-ui"
      }
    ],
    "surfaces": [
      {
        "id": "triggers-page",
        "bundleId": "main",
        "exportName": "triggers-page"
      },
      {
        "id": "trigger-panel",
        "bundleId": "main",
        "exportName": "trigger-panel"
      }
    ]
  },
  "contributions": {
    "pages": [
