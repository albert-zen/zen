        "id": "triggers",
        "title": "Triggers",
        "route": "/plugins/zenx-triggers/triggers",
        "surfaceId": "triggers-page"
      }
    ],
    "sidebar": [
      {
        "id": "triggers",
        "label": "Triggers",
        "icon": "clock",
        "pageId": "triggers",
        "order": 10
      }
    ],
    "commands": [
      {
        "id": "threads",
